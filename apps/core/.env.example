DJANGO_ENV=local
DJANGO_SECRET_KEY=dev-only-change-me

# Base URL of this backend (used to construct absolute URLs)
BASE_URL=http://localhost:8000

# Web frontend origin, used to build the CLI device-flow authorize URL
# and as the default for CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS.
WEB_BASE_URL=http://localhost:3001

# Comma-separated lists; default to WEB_BASE_URL.
# CORS_ALLOWED_ORIGINS=http://localhost:3001
# CSRF_TRUSTED_ORIGINS=http://localhost:3001

# API version prefix; must match NEXT_PUBLIC_API_VERSION in web/.
API_VERSION_PREFIX=v1

# Ollama is BYO; point at a reachable instance.
#   Local on the same Mac/Linux box: keep host.docker.internal
#   Remote (LAN box, GPU server, cloud): set to http://your-host:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Sliding-window concurrency for judge calls (default 1 = serial).
# On local Ollama with a 7B model the GPU contention typically eats
# the parallelism win: per-call latency climbs as fast as throughput,
# so the wall-clock gain is small (or negative) and instant-delivery
# listeners feel slower. Worth bumping when:
#   - You're on cloud LLM APIs (Anthropic / OpenAI) where the
#     bottleneck is HTTP, not local GPU, and N=8-20 is reasonable.
#   - You have a beefier GPU with headroom to run N model instances
#     without per-call slowdown.
#   - You're driving a backfill and want raw throughput, latency be
#     damned.
# Must be matched by `OLLAMA_NUM_PARALLEL` on the Ollama server.
# OLLAMA_CONCURRENCY=1

# Webhook notifier security gates. Defaults are permissive for single-tenant
# self-host (so internal targets like an OpenClaw instance on a private IP work).
# For multi-tenant / public deployments, set both to "true".
# WEBHOOK_REQUIRE_HTTPS=false
# WEBHOOK_BLOCK_PRIVATE_IPS=false
