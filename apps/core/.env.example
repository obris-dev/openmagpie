# Selects the settings module. UNSET defaults to "cloud" (hosted, locked down:
# DEBUG=False, secure cookies, SSRF gates, pinned Brevo SMTP) so a prod deploy
# that forgets this fails SAFE — never into dev settings. This dev env file
# explicitly opts into "local" (-> conf.settings.local).
DJANGO_ENV=local
DJANGO_SECRET_KEY=local-only-change-me

# Required when DJANGO_ENV=cloud (comma-separated): the exact Host header(s)
# THIS backend serves — i.e. wherever the API is reached, NOT the marketing /
# app frontends. Redirect www -> apex at the edge so you list one canonical
# host. Browser origins that call the API (incl. www, if served) go in
# CORS_ALLOWED_ORIGINS, not here.
# ALLOWED_HOSTS=api.openmagpie.ai

# Base URL of this backend (used to construct absolute URLs)
BASE_URL=http://localhost:8000

# Product app origin: the CLI device-flow authorize URL + the cookie-auth
# Origin allowlist. Also a default CORS/CSRF origin.
APP_BASE_URL=http://localhost:3001

# Marketing site origin (public landing + waitlist). Used for links in outbound
# email; also an allowed CORS origin.
MARKETING_BASE_URL=http://localhost:3000

# Comma-separated lists; default to APP_BASE_URL.
# In PROD include the MARKETING site origin too — its public waitlist form
# POSTs cross-origin (application/json -> CORS preflight), so a missing origin
# makes every signup preflight fail (the form just shows an error). Dev adds
# the localhost marketing origin automatically (see settings/local.py).
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com,https://example.com

# API version prefix; must match NEXT_PUBLIC_API_VERSION in web/.
API_VERSION_PREFIX=v1

# Postgres. Inside docker the core container reaches the db service by its
# compose name `db` (not localhost). Dev creds; change for any real deploy.
POSTGRES_DB=openmagpie
POSTGRES_USER=openmagpie
POSTGRES_PASSWORD=openmagpie
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Where is your LLM running? ENGINE_BASE_URL is the OpenAI-compatible `/v1` base URL
# of any backend (the quickstart finds a local one + lets you pick a model).
# Examples:
#   Ollama on the same box:        http://host.docker.internal:11434/v1
#   vLLM / llama.cpp / LM Studio:  http://your-host:8000/v1  (:8080 / :1234)
#   OpenAI or another hosted API:  https://api.openai.com/v1   (set ENGINE_API_KEY)
ENGINE_BASE_URL=http://host.docker.internal:11434/v1
# ENGINE_MODEL is the model id to judge with - left unset on purpose (a generic
# default would be wrong; models are backend-specific). The quickstart sets it
# from your LLM's model list; or list them yourself and set it here:
#   uv run --package openmagpie-core python -m engine.scripts.probe http://localhost:11434/v1
# Unset is fine to boot (you'll get an engine.W001 warning until it's set).
# ENGINE_MODEL=
# Bearer key for HOSTED LLMs (OpenAI/Together/Groq/...). Leave blank for a local
# server you run yourself.
ENGINE_API_KEY=

# Webhook notifier security gates. Defaults are permissive for single-tenant
# self-host (so internal targets like an OpenClaw instance on a private IP work).
# For multi-tenant / public deployments, set both to "true".
# WEBHOOK_REQUIRE_HTTPS=false
# WEBHOOK_BLOCK_PRIVATE_IPS=false
# Per-POST timeout (seconds) for a webhook delivery.
# WEBHOOK_TIMEOUT_SECONDS=30

# Transactional email. Enqueued on signup (a cheap insert — never blocks/fails
# the request) and delivered out-of-request by the send_outbound_emails drain:
# render via the email-render service (web/apps/email-render), send via
# EMAIL_BACKEND.
#
# Dev: console backend prints mail to the drain's output (no SMTP creds needed);
# EMAIL_RENDER_URL defaults to http://web:3010 (the sidecar; see settings/local.py).
# PROD: set EMAIL_RENDER_URL and switch EMAIL_BACKEND to SMTP with real creds
# (e.g. Brevo). If render/SMTP is missing or broken the drain does NOT silently
# skip — it retries the row to EMAIL_SEND_MAX_ATTEMPTS, then marks it FAILED.
# EMAIL_RENDER_URL=http://web:3010
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=OpenMagpie <noreply@openmagpie.ai>
# Bounds the render request AND the SMTP send so a hung server can't pin a
# worker. Seconds.
# EMAIL_TIMEOUT=10
# Outbound-email queue drain (send_outbound_emails): retry cap, stale-reap
# window, and retry backoff. Seconds (except the attempt count).
# EMAIL_SEND_MAX_ATTEMPTS=5
# EMAIL_SEND_STALE_SECONDS=300
# EMAIL_SEND_RETRY_SECONDS=300

# Per-IP rate for the public POST /v1/waitlist endpoint (DRF throttle syntax).
# WAITLIST_THROTTLE_RATE=30/hour
