{
  "name": "@magpie/marketing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "copy-installer": "cp \"$(git rev-parse --show-toplevel)/scripts/quickstart/bootstrap.sh\" public/install.sh",
    "gen-llms-full": "node scripts/gen-llms-full.mjs",
    "prebuild": "pnpm run copy-installer && pnpm run gen-llms-full",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.5",
    "@magpie/api-utils": "workspace:*",
    "@magpie/tailwind-config": "workspace:*",
    "@magpie/ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.19.11",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.98.0"
  }
}
