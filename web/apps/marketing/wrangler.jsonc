{
  // Cloudflare Workers deploy for the @magpie/marketing Next.js app (OpenNext).
  // Generic + deployment-agnostic on purpose: no account_id, no routes/custom
  // domains, no secrets. The operator sets those out-of-band — `wrangler login`
  // (or CLOUDFLARE_ACCOUNT_ID), the custom domains in the Cloudflare dashboard
  // (openmagpie.ai + www -> this worker), and env/secrets via `wrangler secret`
  // / dashboard vars. A self-hoster overrides `name` + their own domain.
  "main": ".open-next/worker.js",
  "name": "openmagpie-marketing",
  // Serve only on the configured custom domains; don't expose the *.workers.dev
  // URL. Applies on the next deploy.
  "workers_dev": false,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
