# config/ holds the user's feed/watch configs. The committed README + templates
# stay tracked; everything else (the seeded quickstart/ instance + anything the
# user writes) is theirs and ignored.
/config/*
!/config/README.md
!/config/templates/

# Local export artifacts from `magpie activity export -o <file>` (CSV / NDJSON).
# Generated data dumps, not source; root-anchored so test fixtures under
# apps/*/tests/ are unaffected. Force-add (`git add -f`) if you ever need one.
/*.csv
/*.ndjson
/*.jsonl

# local-only: override docker-compose ports when the host ports are taken (see docker-compose.override.yml)
docker-compose.override.yml
