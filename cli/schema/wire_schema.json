      "ListenerWire": {
        "description": "One listener as it goes over the wire (list / create / dry-run /\nget / edit all serialize through this). Tolerates an unsaved\ninstance: `created_at` is null pre-save; `id` is null on the create\ndry-run preview (no persisted row yet).",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
