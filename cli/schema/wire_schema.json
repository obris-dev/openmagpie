      "WireSummary": {
        "description": "Display projection the server always fully populates (empty\nstrings/lists, never absent). Distinct from `configs.\nListenerConfigSummary` (which keeps defaults for the server-side\nfallback path) so the published schema stays default-free.",
        "properties": {
          "streams": {
            "items": {
              "type": "string"
            },
            "title": "Streams",
            "type": "array"
          },
          "notifiers": {
            "items": {
              "type": "string"
            },
            "title": "Notifiers",
            "type": "array"
          },
